{
  "name": "lavivenzia",
  "version": "0.1.0",
  "private": true,
  "description": "La Vivenzia — curated experiential tourism marketplace",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "seed:pilot": "tsx scripts/seed-pune-pilot.ts",
    "grant-role": "tsx scripts/grant-role.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:test:setup": "tsx scripts/db-test-setup.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify:full": "npm run verify && npm run db:verify && npm run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.34.1",
    "tsx": "^4.23.12",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
