// La Vivenzia — database schema
// System of record: PostgreSQL (PROJECT.md §5, SYSTEM_DESIGN.md §5).
//
// Scope at this stage is the identity, authorization and audit foundation only.
// Marketplace entities (Experience, Booking, Payment, Ledger, ...) are added in
// later phases, once the blocking product decisions listed in PROJECT_STATE.md
// are resolved — several of them determine column-level structure.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs live in prisma.config.ts (Prisma 7 moved them out of the
// schema). Runtime connections are made through the pg driver adapter in
// src/lib/db.ts; the CLI uses the direct, unpooled URL for migrations.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A human account. One row per person regardless of how many roles they hold —
/// a host who also books experiences is one User with two roles.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// citext: email uniqueness must be case-insensitive.
  email           String    @unique @db.Citext
  /// Null for passwordless accounts (traveller email-OTP flow).
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  /// TOTP secret, encrypted at rest by the application before storage.
  /// Mandatory for admin/operations/finance roles (ADR-0005).
  mfaSecret     String?   @map("mfa_secret")
  mfaEnrolledAt DateTime? @map("mfa_enrolled_at") @db.Timestamptz(3)

  status UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete: retained for financial and audit traceability.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  sessions  Session[]
  roles     UserRole[]
  auditLogs AuditLog[]
  /// Present only once the user completes host onboarding.
  host      Host?

  /// Review decisions this user made as an operations reviewer.
  hostsReviewed       Host[]       @relation("HostReviewer")
  experiencesReviewed Experience[] @relation("ExperienceReviewer")

  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

/// Server-side session (ADR-0005). Sessions are opaque IDs held in an httpOnly
/// cookie, not JWTs, so that suspending a host or deprovisioning an admin takes
/// effect immediately rather than at token expiry.
///
/// `tokenHash` stores a hash of the session token, never the token itself: a
/// database disclosure must not hand over live sessions.
model Session {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  /// Set once the session clears MFA, for roles that require it.
  mfaSatisfiedAt DateTime? @map("mfa_satisfied_at") @db.Timestamptz(3)

  /// Recorded for audit and anomaly detection, not for authorization.
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Explicit revocation, distinct from expiry, so it is visible in audit.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Authorization (RBAC)
// ---------------------------------------------------------------------------

/// Roles are data, not hard-coded constants, so operations can introduce a role
/// without a deploy. REQUIREMENTS.md §2 defines six actors.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  /// Stable machine key, e.g. "traveller", "host", "finance".
  key         String  @unique
  name        String
  description String?

  /// System roles cannot be deleted or renamed through the admin console.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// A single capability, e.g. "booking:refund". Checked at the service layer so
/// that workers and internal callers are governed by the same rules as HTTP.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  /// Nullable: seeded system grants have no granting user.
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of privileged actions (FR-15, SYSTEM_DESIGN §12).
/// Never updated or deleted; retention is handled by archival, not mutation.
model AuditLog {
  id BigInt @id @default(autoincrement())

  /// Null for system-initiated actions (scheduled jobs, webhooks).
  actorId   String? @map("actor_id") @db.Uuid
  /// Session that performed the action, when one exists.
  sessionId String? @map("session_id") @db.Uuid

  /// Verb, e.g. "role.granted", "session.revoked".
  action      String
  /// Target type and identifier, e.g. ("user", "<uuid>").
  subjectType String  @map("subject_type")
  subjectId   String? @map("subject_id")

  /// Before/after snapshots. JSON is appropriate here: this is an audit record,
  /// not core relational business data (DEVELOPMENT_WORKFLOW.md → Database).
  before Json?
  after  Json?

  ipAddress     String? @map("ip_address") @db.Inet
  correlationId String? @map("correlation_id")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([subjectType, subjectId])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A one-time code issued for a passwordless flow (ADR-0005: travellers sign in
/// with email OTP rather than a password).
///
/// The code itself is never stored — only a hash — so a database disclosure
/// cannot be replayed into an account takeover. Codes are single-use:
/// `consumedAt` is set inside the same transaction that creates the session.
model OtpChallenge {
  id      String     @id @default(uuid()) @db.Uuid
  /// Recipient. Not a foreign key: a challenge may be issued for an address
  /// that has no account yet, and must look identical either way so the
  /// response cannot be used to enumerate registered users.
  email   String     @db.Citext
  purpose OtpPurpose

  codeHash String @map("code_hash")

  /// Failed verification attempts against this challenge. A challenge is burned
  /// after too many, so a 6-digit code cannot be brute-forced within its life.
  attempts Int @default(0)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  /// Recorded for abuse investigation, never for authorization.
  requestedIp String? @map("requested_ip") @db.Inet

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

enum OtpPurpose {
  LOGIN
  EMAIL_VERIFICATION

  @@map("otp_purpose")
}

/// Fixed-window counter backing rate limits.
///
/// Lives in PostgreSQL rather than Redis, consistent with ADR-0001: the
/// endpoints that need precise limiting (login, OTP issuance) are low-volume and
/// high-value, and volumetric protection belongs at the edge (WAF). Keeping the
/// counter here also leaves a durable trail of abuse attempts.
model RateLimitCounter {
  /// Scope plus subject, e.g. "otp:request:user@example.com" or "login:ip:1.2.3.4".
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@index([windowStart])
  @@map("rate_limit_counters")
}

// ---------------------------------------------------------------------------
// Hosts (FR-05)
// ---------------------------------------------------------------------------

/// A host's business profile. One row per user who operates experiences.
///
/// Separate from `User` rather than columns on it: a person is one identity but
/// may or may not be a business, and every field here is business identity that
/// a traveller-only account has no use for. It also keeps the host's public
/// brand distinct from the private account that owns it.
model Host {
  id     String @id @default(uuid()) @db.Uuid
  /// One host profile per user. The role grant is separate — holding the `host`
  /// role is what authorizes creating this row, not the other way round.
  userId String @unique @map("user_id") @db.Uuid

  /// Public brand name, shown to travellers.
  displayName String   @map("display_name")
  /// Registered legal entity, where it differs from the brand. Needed before
  /// verification; never shown publicly.
  legalName   String?  @map("legal_name")
  hostType    HostType @default(INDIVIDUAL) @map("host_type")

  /// Operational contact. Not the login address: a business mailbox is often a
  /// different address from the one a person signs in with.
  contactEmail String? @map("contact_email") @db.Citext
  contactPhone String? @map("contact_phone")
  websiteUrl   String? @map("website_url")

  /// Editorial copy. `headline` is a single positioning line; `about` is
  /// long-form and appears on the public host page.
  headline String?
  about    String?

  /// Where the host is based. Distinct from where any one experience happens.
  city    String?
  region  String?
  country String  @default("IN")

  /// Verification lifecycle (FR-05, FR-15). Documents are deliberately NOT
  /// collected yet — KYC document storage needs an encryption-at-rest and
  /// retention decision that has not been made. Status is modelled; the
  /// document workflow arrives with the operations console.
  verificationStatus HostVerificationStatus @default(DRAFT) @map("verification_status")
  submittedAt        DateTime?              @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  /// Operations user who decided. Null while unreviewed.
  reviewedBy         String?                @map("reviewed_by") @db.Uuid
  /// Shown to the host so a rejection is actionable rather than opaque.
  reviewNote         String?                @map("review_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]
  /// SetNull, not Cascade: a decision outlives the person who made it, and a
  /// host record must not disappear because a reviewer left the company.
  reviewer    User?        @relation("HostReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  /// Keyword search matches a host's brand name too, so it needs the same
  /// trigram support as the experience text columns.
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("hosts")
}

enum HostType {
  INDIVIDUAL
  COMPANY

  @@map("host_type")
}

enum HostVerificationStatus {
  /// Profile exists, not yet submitted. The host can still edit everything.
  DRAFT
  /// Submitted and awaiting an operations decision. Locked to the host.
  PENDING
  VERIFIED
  REJECTED

  @@map("host_verification_status")
}

// ---------------------------------------------------------------------------
// Experience inventory (FR-06, FR-07)
// ---------------------------------------------------------------------------

/// A curated experience offered by a host.
///
/// Availability, pricing rules, bookings and reviews all hang off this row in
/// later phases, so the identifiers and the lifecycle are the parts that must be
/// right now — they are what everything downstream will reference.
model Experience {
  id     String @id @default(uuid()) @db.Uuid
  hostId String @map("host_id") @db.Uuid

  /// Stable public identifier, generated from the title at creation and never
  /// silently regenerated: a slug that changes breaks every shared link and
  /// every search-engine record pointing at it.
  slug  String @unique
  title String

  /// One-line editorial hook, used on cards and in search results.
  summary     String?
  description String?

  categoryId String? @map("category_id") @db.Uuid

  status ExperienceStatus @default(DRAFT)

  /// Where the experience happens.
  addressLine String?  @map("address_line")
  city        String?
  region      String?
  country     String   @default("IN")
  postalCode  String?  @map("postal_code")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  /// Spatial column for nearby and map-viewport discovery (FR-03, ADR-0008).
  ///
  /// Prisma has no PostGIS type, so it is declared `Unsupported` — the column
  /// exists and is indexed, but is read through raw SQL when search lands. It is
  /// GENERATED from latitude/longitude, so it cannot drift out of step with
  /// them, and it is added now because retrofitting a spatial column onto a
  /// populated core table is the expensive path ADR-0008 exists to avoid.
  geo Unsupported("geography(Point, 4326)")? @default(dbgenerated())

  durationMinutes Int?     @map("duration_minutes")
  minGuests       Int      @default(1) @map("min_guests")
  maxGuests       Int?     @map("max_guests")
  /// Languages the experience is delivered in, as ISO 639-1 codes.
  languages       String[] @default([])

  /// The host's own list price, in the smallest currency unit — paise for INR.
  ///
  /// Integer minor units, never a float: 0.1 + 0.2 is not 0.3 in binary
  /// floating point, and this number becomes money.
  ///
  /// This is the price the host sets and nothing else. No platform fee, no
  /// commission, no GST and no TCS is stored, derived or implied here — those
  /// are unresolved business decisions (docs/ASSUMPTIONS.md A-003, A-005) and
  /// each would add its own columns when settled.
  basePriceMinor Int?        @map("base_price_minor")
  currency       String      @default("INR") @db.Char(3)
  pricingUnit    PricingUnit @default(PER_PERSON) @map("pricing_unit")

  /// What the price does and does not cover. Plain text lists rather than a
  /// relation: they are editorial copy shown verbatim, never queried or joined.
  inclusions String[] @default([])
  exclusions String[] @default([])
  /// Practical guest instructions — what to bring, what to expect.
  guestNotes String?  @map("guest_notes")

  /// Lifecycle timestamps (FR-07). Kept as columns rather than derived from the
  /// audit log because they are read on every listing screen.
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewNote  String?   @map("review_note")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  host     Host              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  category Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media    ExperienceMedia[]
  slots    ExperienceSlot[]
  /// See the note on Host.reviewer.
  reviewer User?             @relation("ExperienceReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  /// The host dashboard lists a host's own experiences newest-first, and
  /// operations lists everything awaiting review. Both are covered here.
  ///
  /// The three GIN trigram indexes serve traveller keyword search (FR-02).
  /// Without them, `ILIKE '%term%'` is a sequential scan on every keystroke,
  /// and `similarity()` ranking would have to score the whole table. They are
  /// declared here rather than created by raw SQL in a migration so that
  /// `prisma migrate diff` stays clean — an index the schema does not know
  /// about is one the next `migrate dev` generates a DROP for.
  @@index([geo], type: Gist)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([hostId, status, updatedAt])
  @@index([status, submittedAt])
  @@index([categoryId])
  @@map("experiences")
}

enum ExperienceStatus {
  /// Being written. Editable, invisible to travellers.
  DRAFT
  /// Submitted for approval. Locked to the host until a decision.
  IN_REVIEW
  /// Approved and visible. Publication is an operations action, never the
  /// host's own — FR-07 requires approval between draft and published.
  PUBLISHED
  /// Rejected with a note. Returns to the host's control for editing.
  REJECTED
  /// Withdrawn by operations after publication.
  SUSPENDED
  /// Retired by the host. Retained rather than deleted: past bookings and
  /// payouts must keep referring to something.
  ARCHIVED

  @@map("experience_status")
}

enum PricingUnit {
  PER_PERSON
  PER_GROUP

  @@map("pricing_unit")
}

/// An image belonging to an experience.
///
/// Rows are created only after the bytes are stored, so a row always refers to
/// something that exists. `storageKey` is generated server-side and is unique —
/// the client never chooses where its file lands.
model ExperienceMedia {
  id           String @id @default(uuid()) @db.Uuid
  experienceId String @map("experience_id") @db.Uuid

  storageKey  String  @unique @map("storage_key")
  contentType String  @map("content_type")
  byteSize    Int     @map("byte_size")
  width       Int?
  height      Int?
  /// Alternative text. Nullable because it is authored after upload, but the
  /// completeness check asks for it before submission — an experience gallery
  /// with no alt text is inaccessible to exactly the travellers who need it.
  altText     String? @map("alt_text")

  /// Display order within the gallery. Zero is the cover image.
  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, position])
  @@map("experience_media")
}

/// Experience categories (FR-06). Reference data, seeded and reconciled like
/// roles — operations can reorder or retire one without a deploy.
model Category {
  id          String  @id @default(uuid()) @db.Uuid
  /// Stable machine key, e.g. "culinary". Referenced by code and by URLs.
  key         String  @unique
  name        String
  description String?
  /// Editorial ordering in menus and filters.
  position    Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  experiences Experience[]

  @@index([isActive, position])
  @@map("categories")
}

/// When a slot is open to booking (FR-08).
enum SlotStatus {
  /// Accepting bookings, subject to capacity and the cut-off.
  OPEN
  /// Closed by the host. Existing reservations stand; no new ones.
  CLOSED
}

/// One bookable occurrence of an experience (FR-08).
///
/// Availability is modelled as explicit slots rather than as a recurrence rule
/// on the experience. A rule has to be expanded to be booked against, and the
/// expansion is where double-booking bugs live; a row per occurrence means the
/// thing a traveller reserves is the thing the database constrains.
///
/// **`reservedCount` is the seat ledger, and the database owns its invariants.**
/// Phase 6 will increment it inside the booking transaction. Every rule that
/// matters is a CHECK constraint rather than application logic, so a bug in a
/// future booking path cannot oversell a slot: see the migration for
/// `experience_slots_reserved_within_capacity`.
model ExperienceSlot {
  id           String @id @default(uuid()) @db.Uuid
  experienceId String @map("experience_id") @db.Uuid

  /// Stored as timestamptz: a slot is an instant, and hosts and travellers are
  /// not always in the same zone. Rendering is the UI's problem.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// Total seats for this occurrence. Distinct from the experience's
  /// `maxGuests`, which caps a single party rather than the whole slot.
  capacity Int

  /// Seats committed. Always 0 until booking ships — kept here rather than
  /// derived from a bookings table so the capacity invariant can be a CHECK
  /// constraint instead of a query that races.
  reservedCount Int @default(0) @map("reserved_count")

  /// Minutes before `startsAt` that booking closes. 0 means right up to the
  /// start. A host operations setting, not a pricing or cancellation rule.
  bookingCutoffMinutes Int @default(0) @map("booking_cutoff_minutes")

  status SlotStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  /// Two slots for one experience cannot begin at the same instant. Overlap
  /// beyond that is checked in the domain, where the end time is known.
  @@unique([experienceId, startsAt])
  @@index([experienceId, startsAt])
  @@index([startsAt])
  @@map("experience_slots")
}
