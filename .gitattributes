# Normalise line endings.
#
# Development happens on Windows; CI and production run on Linux. Without this,
# CRLF endings leak into files that are executed inside containers — shell
# scripts and Dockerfiles fail with confusing "not found" errors caused by a
# trailing \r on the shebang line.
#
# Text files are stored as LF in the repository and checked out as LF.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.pdf binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.vhdx binary

# Generated; collapse in diffs and mark as not-authored for language stats.
package-lock.json linguist-generated=true -diff
src/generated/** linguist-generated=true
