# La Vivenzia — environment template
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
# NEVER commit a populated env file. `.env*` is gitignored except this template.
#
# Precedence matches Next.js: a real shell variable beats `.env.local`, which
# beats `.env`.
# Deployed environments read these from AWS Secrets Manager / SSM, not files.
# Validation lives in src/lib/env.ts — the process refuses to boot if a required
# variable is missing or malformed.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development

# Pooled connection used by the app and worker at runtime.
# Matches the credentials in docker-compose.yml; run `npm run db:up` first.
DATABASE_URL=postgresql://lavivenzia:lavivenzia_local_dev@localhost:5432/lavivenzia

# Direct, unpooled connection used by Prisma Migrate.
# Required in production; migrations cannot run through a transaction pooler.
DIRECT_DATABASE_URL=postgresql://lavivenzia:lavivenzia_local_dev@localhost:5432/lavivenzia

# Throwaway database used by `prisma migrate diff` to verify that the schema and
# the migrations directory agree. Never holds real data.
SHADOW_DATABASE_URL=postgresql://lavivenzia:lavivenzia_local_dev@localhost:5432/lavivenzia_shadow

# Dedicated database for integration tests. They truncate tables, so this must
# never point at the development database. The name must contain "test".
# Create it with: npm run db:test:setup
TEST_DATABASE_URL=postgresql://lavivenzia:lavivenzia_local_dev@localhost:5432/lavivenzia_test

# Canonical public origin. Must be https in production.
APP_URL=http://localhost:3000

LOG_LEVEL=info

# Signs the server-side session cookie. Minimum 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=5

# Discovery offline fallback. Unset = on outside production, off in production.
# When Postgres is unreachable, the homepage and copilot serve the Pune pilot
# catalogue from memory. Set true only on a database-less preview, never on the
# real production deployment.
DISCOVERY_OFFLINE_FALLBACK=

# ---------------------------------------------------------------------------
# Providers — all optional at this stage.
# The adapters are boundaries only; each asserts its own credentials when wired.
# ---------------------------------------------------------------------------

# Razorpay. Only the webhook secret is used today (signature verification).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anthropic (AI discovery, later phase).
ANTHROPIC_API_KEY=

# Embeddings — NO PROVIDER SELECTED. Awaiting founder approval (ADR-0007).
# Do not populate these until the decision is made: the chosen model fixes the
# pgvector column dimension.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=

# Google Maps (FR-03, later phase).
GOOGLE_MAPS_API_KEY=

# AWS
# Credentials are NOT set here in a deployed environment: the SDK resolves them
# through the standard provider chain, which means the task's IAM role on ECS.
# Locally, if you ever need to send through real SES, use `aws sso login` or an
# AWS_PROFILE rather than pasting keys into this file.
AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Email (ADR-0011, docs/EMAIL.md)
# ---------------------------------------------------------------------------

# `console` renders each message and writes it to the log instead of sending it,
# so the whole login flow works with no AWS account. `ses` actually delivers.
# Production refuses `console` at startup.
# `console` prints the message (including the login code) to the terminal, so
# the whole login flow works with no provider account. `resend` and `ses`
# actually deliver. Production refuses `console` at startup.
EMAIL_TRANSPORT=console

# Sender address. Must be on a domain verified with whichever provider is
# selected. Required in production; unused by the console transport.
EMAIL_FROM=

# --- Resend (current provider) ----------------------------------------------
# Create at https://resend.com → API Keys. Sending permission is enough.
# Never commit a real key: this file is an example, `.env.local` is gitignored.
RESEND_API_KEY=

# --- Amazon SES (retained for rollback) -------------------------------------
# SES remains fully implemented and tested. Rolling back is one variable:
# set EMAIL_TRANSPORT=ses with EMAIL_FROM and AWS_REGION configured.
#
# SES configuration set. Optional, but it is what publishes bounce and complaint
# events — without one those signals never reach us.
SES_CONFIGURATION_SET=

# ---------------------------------------------------------------------------
# Experience media (ADR-0013)
# ---------------------------------------------------------------------------

# `local` writes under public/uploads, which Next.js serves statically, so the
# media flow works with no AWS account. Production refuses it at startup: a
# container filesystem is ephemeral, so uploads would be lost on the next deploy.
MEDIA_STORAGE=local

# Required when MEDIA_STORAGE=s3.
# --- Object storage: Cloudflare R2 (S3-compatible) --------------------------
# `local` writes into public/uploads and is development only — production
# refuses it, because container filesystems are ephemeral and uploads would be
# lost on every deploy.
#
# Two different hosts, and conflating them is the usual R2 mistake:
#   S3_ENDPOINT        where objects are WRITTEN (the S3 API)
#   S3_PUBLIC_BASE_URL where browsers READ them (r2.dev or a custom domain)
# Using the endpoint for both produces URLs that 401 for every traveller.
#
# Credentials come from Cloudflare → R2 → Manage API Tokens. Never commit a
# real key: this file is an example, `.env.local` is gitignored.
S3_MEDIA_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Observability
SENTRY_DSN=
POSTHOG_KEY=
