# La Vivenzia — environment template
#
# Copy to `.env` for local development. NEVER commit a populated .env.
# Deployed environments read these from AWS Secrets Manager / SSM, not files.
# Validation lives in src/lib/env.ts — the process refuses to boot if a required
# variable is missing or malformed.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development

# Pooled connection used by the app and worker at runtime.
# Matches the credentials in docker-compose.yml; run `npm run db:up` first.
DATABASE_URL=postgresql://lavivenzia:lavivenzia_local_dev@localhost:5432/lavivenzia

# Direct, unpooled connection used by Prisma Migrate.
# Required in production; migrations cannot run through a transaction pooler.
DIRECT_DATABASE_URL=postgresql://lavivenzia:lavivenzia_local_dev@localhost:5432/lavivenzia

# Throwaway database used by `prisma migrate diff` to verify that the schema and
# the migrations directory agree. Never holds real data.
SHADOW_DATABASE_URL=postgresql://lavivenzia:lavivenzia_local_dev@localhost:5432/lavivenzia_shadow

# Canonical public origin. Must be https in production.
APP_URL=http://localhost:3000

LOG_LEVEL=info

# Signs the server-side session cookie. Minimum 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Providers — all optional at this stage.
# The adapters are boundaries only; each asserts its own credentials when wired.
# ---------------------------------------------------------------------------

# Razorpay. Only the webhook secret is used today (signature verification).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anthropic (AI discovery, later phase).
ANTHROPIC_API_KEY=

# Embeddings — NO PROVIDER SELECTED. Awaiting founder approval (ADR-0007).
# Do not populate these until the decision is made: the chosen model fixes the
# pgvector column dimension.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=

# Google Maps (FR-03, later phase).
GOOGLE_MAPS_API_KEY=

# AWS
AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=

# Email
EMAIL_FROM=

# Observability
SENTRY_DSN=
POSTHOG_KEY=
